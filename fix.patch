diff --git a/mysys/ma_dyncol.c b/mysys/ma_dyncol.c
--- a/mysys/ma_dyncol.c
+++ b/mysys/ma_dyncol.c
@@ -112,6 +112,13 @@
 #define MAX_OFFSET_LENGTH_NM 5

 #define DYNCOL_NUM_CHAR 6
+/*
+  A numeric lookup key arrives from SQL as a uint (up to 4294967295, i.e. 10
+  decimal digits), not just the 2-byte stored key that DYNCOL_NUM_CHAR fits.
+  backwritenum() renders the key backward into the lookup buffer, so the buffer
+  must hold every digit of a uint or it underflows (MDEV-42453).
+*/
+#define DYNCOL_NUM_CHAR_LOOKUP 10

 my_bool mariadb_dyncol_has_names(DYNAMIC_COLUMN *str)
 {
@@ -2119,7 +2126,7 @@
 find_column(DYN_HEADER *hdr, uint numkey, LEX_STRING *strkey)
 {
   LEX_STRING nmkey;
-  char nmkeybuff[DYNCOL_NUM_CHAR]; /* to fit max 2 bytes number */
+  char nmkeybuff[DYNCOL_NUM_CHAR_LOOKUP]; /* fit any uint lookup key */
   DBUG_ASSERT(hdr->header != NULL);

   if (hdr->header + hdr->header_size > hdr->data_end)
diff --git a/unittest/mysys/ma_dyncol-t.c b/unittest/mysys/ma_dyncol-t.c
--- a/unittest/mysys/ma_dyncol-t.c
+++ b/unittest/mysys/ma_dyncol-t.c
@@ -818,6 +818,48 @@
 }


+/*
+  MDEV-42453: a numeric lookup key with >= 7 decimal digits underflowed the
+  6-byte nmkeybuff in find_column() (backwritenum() writes digits backward from
+  the buffer end), a stack-buffer-overflow WRITE reachable by any user via
+  COLUMN_GET / COLUMN_EXISTS on a string-format dynamic column. The lookup must
+  return NULL / not-found instead of crashing.
+*/
+static void test_mdev_42453()
+{
+  DYNAMIC_COLUMN str;
+  DYNAMIC_COLUMN_VALUE val, res;
+  MYSQL_LEX_STRING key;
+  uint large_keys[4]= {1000000, 9999999, 2147483647, 4294967295U};
+  uint i;
+  int rc;
+
+  key.length= 1;
+  key.str= (char *) "a";
+  val.type= DYN_COL_INT;
+  val.x.long_value= 1;
+
+  mariadb_dyncol_init(&str);
+  rc= mariadb_dyncol_create_many_named(&str, 1, &key, &val, 1);
+  ok(rc == ER_DYNCOL_OK, "MDEV-42453 create named blob");
+
+  for (i= 0; i < 4; i++)
+  {
+    mariadb_dyncol_value_init(&res);
+    rc= mariadb_dyncol_get_num(&str, large_keys[i], &res);
+    ok(rc == ER_DYNCOL_OK && res.type == DYN_COL_NULL,
+       "MDEV-42453 COLUMN_GET numeric key %u -> NULL", large_keys[i]);
+  }
+
+  mariadb_dyncol_value_init(&res);
+  rc= mariadb_dyncol_get_named(&str, &key, &res);
+  ok(rc == ER_DYNCOL_OK && res.type == DYN_COL_INT && res.x.long_value == 1,
+     "MDEV-42453 named lookup still works");
+
+  mariadb_dyncol_free(&str);
+}
+
+
 #define BIG_STRING_SIZE (1024*1024)
 int main(int argc __attribute__((unused)), char **argv)
 {
@@ -825,7 +867,7 @@
   char *big_string= (char *)malloc(BIG_STRING_SIZE);

   MY_INIT(argv[0]);
-  plan(74);
+  plan(80);

   if (!big_string)
     exit(1);
@@ -962,6 +1004,7 @@
   test_overlong_int(DYN_COL_UINT, "uint");
   test_overlong_int(DYN_COL_INT, "sint");
   test_decimal_precision_overflow();
+  test_mdev_42453();

   my_end(0);
   return exit_status();
